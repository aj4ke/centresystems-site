# centresystems.info
:80 {
	encode zstd gzip

	header Cache-Control "no-cache"

	# backend: game server status, GitHub repos
	handle /api/* {
		reverse_proxy 127.0.0.1:3001
	}

	# notes folder: browse lets notes.html get the file list as JSON
	handle /notes/* {
		root * /var/www/centre
		file_server browse
	}

	handle {
		root * /var/www/centre
		file_server
	}

	log {
		output file /var/log/caddy/access.log
	}
}
